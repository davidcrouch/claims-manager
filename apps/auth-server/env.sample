# =============================================================================
# ENSUREOS AUTH SERVER - ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains all environment variables required for the EnsureOS Auth Server.
# The Auth Server provides OAuth2.1/OIDC authentication services for the EnsureOS product.
# 

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Basic server configuration
NODE_ENV=production                     # Environment: development, production, test
PORT=4000                              # Port number for the auth server to listen on

# Service identification (optional - defaults to 'auth-server')
SERVICE_NAME=auth-server                # Service name for telemetry and logging
SERVICE_VERSION=0.2.1                  # Service version (optional - uses package.json by default)
OTEL_SERVICE_NAME=auth-server          # OpenTelemetry service name (standard)

# OIDC Issuer URL - The base URL for this OAuth2.1/OIDC provider
# This is used in discovery endpoints and token validation
OIDC_ISSUER=https://auth.example.com

# =============================================================================
# SECURITY CONFIGURATION (REQUIRED)
# =============================================================================
# SECURITY: This is a SAMPLE file. Never commit real secrets or private keys.
# Every value below is a placeholder — generate your own before running.

# JWT Secret - Used for signing and verifying JWT tokens
# Must be at least 32 characters long. Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_ME_openssl_rand_hex_32

# JWT audience(s) enforced when validating tokens. REQUIRED in production.
# Must be an absolute URI (RFC 8707). Single value or comma-separated list.
JWT_EXPECTED_AUDIENCE=http://more0.ai

# Resource-indicator allowlist. Comma-separated absolute URIs clients may request
# as token `aud`. Required in production. Issuer is always allowed.
OIDC_ALLOWED_RESOURCES=http://more0.ai

# JWKS (JSON Web Key Set) Configuration for Production JWT Signing
# JWKS Keys for JWT Signing (RSA-2048 + EC P-256)
# Generate a keypair and paste ONLY the components below. NEVER commit real
# private key components (D/P/Q/DP/DQ/QI) to source control.
JWT_PUBLIC_KEY_N=REPLACE_ME_rsa_modulus_base64url
JWT_PUBLIC_KEY_E=AQAB
JWT_PRIVATE_KEY_D=REPLACE_ME_rsa_private_exponent_base64url
JWT_PRIVATE_KEY_P=REPLACE_ME_rsa_prime1_base64url
JWT_PRIVATE_KEY_Q=REPLACE_ME_rsa_prime2_base64url
JWT_PRIVATE_KEY_DP=REPLACE_ME_rsa_exponent1_base64url
JWT_PRIVATE_KEY_DQ=REPLACE_ME_rsa_exponent2_base64url
JWT_PRIVATE_KEY_QI=REPLACE_ME_rsa_coefficient_base64url
# EC P-256 Key Components (Optional - for ES256 signing)
JWT_EC_PRIVATE_KEY_D=REPLACE_ME_ec_private_scalar_base64url
JWT_EC_PUBLIC_KEY_X=REPLACE_ME_ec_x_base64url
JWT_EC_PUBLIC_KEY_Y=REPLACE_ME_ec_y_base64url

# Dynamic Client Registration Secret - Used for secure client registration
# Generate with: openssl rand -hex 32
DYNAMIC_REGISTRATION_SECRET=REPLACE_ME_openssl_rand_hex_32

# DCR IAT Signing Key - Used for signing Initial Access Tokens in DCR
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
DCR_IAT_SIGNING_KEY=REPLACE_ME_openssl_rand_base64_32

# =============================================================================
# REDIS CONFIGURATION (REQUIRED)
# =============================================================================
# Redis is used for session storage, token caching, and rate limiting
# Use shared infra Redis by default (infra/compose.yaml => localhost:3250)
REDIS_PROVIDER="self-hosted"             # self-hosted | upstash
REDIS_HOST="localhost"
REDIS_PORT=3250
REDIS_DB=0
REDIS_TLS=false
# REDIS_PASSWORD=""
# Redis at-rest token encryption key. REQUIRED in production — the server
# refuses to start without it so OAuth tokens are never stored in plaintext.
# 32-byte key as 64 hex chars. Generate with: openssl rand -hex 32
REDIS_ENCRYPTION_KEY=REPLACE_ME_openssl_rand_hex_32
#
# If using Upstash instead:
# REDIS_PROVIDER="upstash"
# UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# =============================================================================
BASE_URL=https://auth.example.com

# =============================================================================
# GOOGLE OAUTH CONFIGURATION (OPTIONAL)
# =============================================================================
# Google OAuth credentials for social login integration
# Get these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# MICROSOFT OAUTH CONFIGURATION (OPTIONAL)
# =============================================================================
# Microsoft Entra ID (Azure AD) credentials for social login
# Get these from Azure Portal > App Registrations
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# MICROSOFT_TENANT_ID=common               # 'common' for multi-tenant, or specific tenant ID

# =============================================================================
# JWT AUDIENCE ENFORCEMENT (REQUIRED IN PRODUCTION)
# =============================================================================
# Comma-separated list of expected audience values for JWT validation
# Tokens must have an `aud` claim matching one of these values
# (Also set above as JWT_EXPECTED_AUDIENCE in SECURITY CONFIGURATION)

# =============================================================================
# PLATFORM ADMIN AUTO-PROMOTE
# =============================================================================
# Comma-separated emails that are auto-granted platform_admin on first login
# PLATFORM_ADMIN_EMAILS=ops@example.com

# =============================================================================
# REDIS ENCRYPTION AT REST (REQUIRED IN PRODUCTION)
# =============================================================================
# Set REDIS_ENCRYPTION_KEY in the Redis section above.

# =============================================================================
# EMAIL CONFIGURATION (OPTIONAL)
# =============================================================================
# Provider: console (dev - logs to stdout), smtp, or resend (production)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@ensureos.com
# EMAIL_REPLY_TO=support@ensureos.com

# SMTP Configuration (when EMAIL_PROVIDER=smtp)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Resend Configuration (when EMAIL_PROVIDER=resend)
# RESEND_API_KEY=re_your_api_key

# CORS CONFIGURATION
# =============================================================================
# Allowed origins for Cross-Origin Resource Sharing
# Comma-separated list of allowed origins (protocol + domain + port)
CORS_ORIGINS=http://localhost:3000,http://localhost:3020,https://chat.example.com,https://auth.example.com

# =============================================================================
# TOKEN TTL CONFIGURATION
# =============================================================================
# Token Time-To-Live settings for OIDC tokens
# All values are in seconds
OIDC_ACCESS_TOKEN_TTL=900              # Access token lifetime (15 mins)
OIDC_REFRESH_TOKEN_TTL=604800          # Refresh token lifetime (7 days)
OIDC_ID_TOKEN_TTL=3600                 # ID token lifetime (1 hour)
OIDC_AUTHORIZATION_CODE_TTL=600        # Authorization code lifetime (10 minutes)

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
# Rate limiting settings to prevent abuse
RATE_LIMIT_WINDOW_MS=60                # Time window in seconds (60 = 1 minute)
RATE_LIMIT_MAX_REQUESTS=1000           # Maximum requests per window per IP (10x increase)
RATE_LIMIT_AUTH_MAX_REQUESTS=50        # Maximum auth requests per window per IP
RATE_LIMIT_TOKEN_MAX_REQUESTS=200      # Maximum token requests per window per IP
RATE_LIMIT_OAUTH_MAX_REQUESTS=300      # Maximum OAuth requests per window per IP

# =============================================================================
# MCP CONFIGURATION
# =============================================================================
# MCP (Model Context Protocol) audience URL
# Used for MCP token validation and authorization
AUDIENCE=http://more0.ai

# Ensure Construction platform admin (optional; seeded when password is set).
# Used by db:seed-ensure-admin and by seed-rbac when present.
# ENSURE_PLATFORM_ADMIN_EMAIL=admin@example.com
# ENSURE_PLATFORM_ADMIN_PASSWORD="REPLACE_ME"
# ENSURE_PLATFORM_ADMIN_NAME=Admin

# Resource-indicator allowlist. Comma-separated list of resource URIs
# that clients may request as a token `aud`. The issuer is always allowed.
# Required in production. When unset in development, resource requests stay permissive.
# OIDC_ALLOWED_RESOURCES=http://more0.ai

# =============================================================================
# MOREZERO BACKEND INTEGRATION
# =============================================================================
# Node.js API URL for authentication services
# This is the API server that handles auth endpoints
MOREZERO_NODEJS_API_URL=https://morezero-alb-dev-s3.wonderbricks.com:6040
MOREZERO_KOTLIN_API_URL=https://morezero-alb-dev-s3.wonderbricks.com:6070

# More0 API URL for additional service integration
MOREZERO_API_URL=https://api.example.com

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level for the auth server
# Options: error, warn, info, debug, trace
MOREZERO_LOG_LEVEL='info'
MOREZERO_LOG_LEVELS="auth-server:auth-routes=info, auth-server:oidc-provider=info, auth-server:oidc-provider-events=info, auth-server:token-exchange-service=warn, auth-server:backend-token-exchange-service=warn"
MOREZERO_FORMAT_LOG=false

# =============================================================================
# OIDC COOKIE ENCRYPTION (REQUIRED)
# =============================================================================
# Encryption keys for OIDC cookies
# Must be an array of base64-encoded keys (first key is used for encryption)
# Generate with: openssl rand -base64 32
OIDC_COOKIES_KEYS=["REPLACE_ME_openssl_rand_base64_32","REPLACE_ME_openssl_rand_base64_32_previous_for_rotation"]

# =============================================================================
# STATIC OIDC CLIENT CONFIGURATION (REQUIRED)
# =============================================================================
# Pre-configured OIDC client for chat-ui application
# This client is automatically registered and available for use
OIDC_CLIENT_ID=morezero-chat-ui                                  # Client identifier
OIDC_CLIENT_SECRET=REPLACE_ME_openssl_rand_hex_32
OIDC_CLIENT_CALLBACK_URI=https://chat.example.com/api/auth/oidc/callback  # Primary callback URL for authorization code flow
OIDC_ADDITIONAL_REDIRECT_URIS=https://app.example.com/api/auth/oidc/callback  # Additional redirect URIs (comma-separated) for multiple apps
OIDC_POST_LOGIN_URI=https://chat.example.com/app              # Post-login redirect URL
OIDC_POST_LOGOUT_URI=https://chat.example.com

# =============================================================================
# PUBLIC ORGANISATION SIGNUP (OPTIONAL)
# =============================================================================
# Greenfield "create a new organisation" is allowed only while the database has
# zero organisations (bootstrap). After the first org exists, signup is invite-only.
# Override (optional):
#   ALLOW_PUBLIC_ORG_SIGNUP=true   # always allow new-org signup
#   ALLOW_PUBLIC_ORG_SIGNUP=false  # always deny (even on an empty database)
# ALLOW_PUBLIC_ORG_SIGNUP=

# =============================================================================
# ENVIRONMENT VARIABLE VALIDATION
# =============================================================================
# The auth server will validate all required environment variables on startup.
# If any required variables are missing or invalid, the server will fail to start
# with a descriptive error message.
#
# REQUIRED VARIABLES:
# - NODE_ENV, PORT, OIDC_ISSUER
# - JWT_SECRET, DYNAMIC_REGISTRATION_SECRET, DCR_IAT_SIGNING_KEY
# - REDIS_PROVIDER + (REDIS_HOST, REDIS_PORT) for self-hosted Redis
#   OR REDIS_PROVIDER=upstash + (UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN)
# - OIDC_COOKIES_KEYS, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET, OIDC_CALLBACK_URI
# - MOREZERO_KOTLIN_API_URL
#
# OPTIONAL VARIABLES:
# - CORS_ORIGINS, RATE_LIMIT_*, GOOGLE_CLIENT_*, AUDIENCE, MOREZERO_LOG_LEVEL
# =============================================================================

