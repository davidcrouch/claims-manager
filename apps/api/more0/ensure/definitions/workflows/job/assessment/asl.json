{
  "Comment": "Builder Assessment job lifecycle: Allocated -> Contact -> Schedule -> Attend -> Submit -> Review -> Invoice -> Complete",
  "StartAt": "SetupJob",
  "States": {
    "SetupJob": {
      "Type": "Pass",
      "Comment": "Initialize context with job data and set entityId alias.",
      "Parameters": {
        "jobId.$": "$.jobId",
        "tenantId.$": "$.tenantId",
        "entityType": "job",
        "entityId.$": "$.jobId",
        "phase": "allocated",
        "callToScheduleTaskId.$": "$.callToScheduleTaskId",
        "claimId.$": "$.claimId",
        "lookups.$": "$.lookups",
        "collectExcess.$": "$.collectExcess",
        "excess.$": "$.excess"
      },
      "Next": "CheckInboundTaskExists"
    },
    "CheckInboundTaskExists": {
      "Type": "Choice",
      "Comment": "If a Call to Schedule task ID was supplied at invocation, skip waiting and bind directly.",
      "Choices": [
        {
          "Variable": "$.callToScheduleTaskId",
          "IsPresent": true,
          "Next": "BindInboundCallToScheduleTask"
        }
      ],
      "Default": "WaitForInboundTaskOrCreate"
    },
    "WaitForInboundTaskOrCreate": {
      "Type": "Task",
      "Resource": "states.waitForTaskToken",
      "Parameters": {
        "eventPatterns": [
          {
            "eventType": "task.created",
            "filter": {
              "taskName": "Call to Schedule"
            }
          }
        ]
      },
      "ResultPath": "$.event",
      "Next": "WaitForInboundTaskOrCreate__Route",
      "Comment": "Wait up to 30s for Crunchwork to sync the Call to Schedule task. If timeout, create it ourselves.",
      "TimeoutSeconds": 30,
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.eventTimeout",
          "Next": "CreateCallToScheduleTask"
        }
      ]
    },
    "BindInboundCallToScheduleTaskFromEvent": {
      "Type": "Pass",
      "Comment": "Bind to the inbound task ID from the task.created event.",
      "Parameters": {
        "id.$": "$.event.payload.taskId"
      },
      "ResultPath": "$.callToScheduleTask",
      "Next": "UpdateJobStatusAllocated"
    },
    "BindInboundCallToScheduleTask": {
      "Type": "Pass",
      "Comment": "Use the task ID supplied at invocation.",
      "Parameters": {
        "id.$": "$.callToScheduleTaskId"
      },
      "ResultPath": "$.callToScheduleTask",
      "Next": "UpdateJobStatusAllocated"
    },
    "CreateCallToScheduleTask": {
      "Type": "Task",
      "Comment": "Create the 'Call to Schedule' task on the job.",
      "Resource": "tool.claims.create_task",
      "Parameters": {
        "params": {
          "data": {
            "name": "Call to Schedule",
            "relatedEntityType": "Job",
            "relatedEntityId.$": "$.jobId",
            "jobId.$": "$.jobId",
            "priority": "High",
            "status": "Open",
            "originType": "automation",
            "action": {
              "actionKey": "create_appointment",
              "label": "Schedule appointment",
              "context": {
                "entityType": "Appointment",
                "jobId.$": "$.jobId"
              }
            }
          }
        }
      },
      "ResultPath": "$.callToScheduleTask",
      "Next": "UpdateJobStatusAllocated"
    },
    "UpdateJobStatusAllocated": {
      "Type": "Task",
      "Comment": "Set job status to Allocated and populate Request Date.",
      "Resource": "tool.claims.update_job",
      "Parameters": {
        "params": {
          "id.$": "$.jobId",
          "data": {
            "customData": {
              "workflowPhase": "allocated",
              "requestDate.$": "$.requestDate"
            }
          }
        }
      },
      "ResultPath": "$.jobUpdate",
      "Next": "WaitForContactOrSchedule"
    },
    "WaitForContactOrSchedule": {
      "Type": "Task",
      "Resource": "states.waitForTaskToken",
      "Parameters": {
        "eventPatterns": [
          {
            "eventType": "task.completed",
            "filter": {
              "taskName": "Call to Schedule"
            }
          },
          {
            "eventType": "task.failed",
            "filter": {
              "taskName": "Call to Schedule"
            }
          },
          {
            "eventType": "appointment.scheduled"
          }
        ]
      },
      "ResultPath": "$.event",
      "Next": "WaitForContactOrSchedule__Route",
      "Comment": "Wait for either Call to Schedule task completion, task failure, or appointment being scheduled directly."
    },
    "OnCallToScheduleFailed": {
      "Type": "Task",
      "Comment": "Create a follow-up 'Call to Schedule #2' task.",
      "Resource": "tool.claims.create_task",
      "Parameters": {
        "params": {
          "data": {
            "name": "Call to Schedule #2",
            "relatedEntityType": "Job",
            "relatedEntityId.$": "$.jobId",
            "jobId.$": "$.jobId",
            "priority": "High",
            "status": "Open",
            "originType": "automation",
            "action": {
              "actionKey": "create_appointment",
              "label": "Schedule appointment",
              "context": {
                "entityType": "Appointment",
                "jobId.$": "$.jobId"
              }
            }
          }
        }
      },
      "ResultPath": "$.callToSchedule2Task",
      "Next": "WaitForContactOrScheduleRetry"
    },
    "WaitForContactOrScheduleRetry": {
      "Type": "Task",
      "Resource": "states.waitForTaskToken",
      "Parameters": {
        "eventPatterns": [
          {
            "eventType": "task.completed",
            "filter": {
              "taskName": "Call to Schedule #2"
            }
          },
          {
            "eventType": "appointment.scheduled"
          }
        ]
      },
      "ResultPath": "$.event",
      "Next": "WaitForContactOrScheduleRetry__Route",
      "Comment": "Wait for the follow-up call task or direct appointment scheduling."
    },
    "OnAppointmentScheduledEarly": {
      "Type": "Task",
      "Comment": "Appointment scheduled before Call to Schedule was completed. Update job dates first.",
      "Resource": "tool.claims.update_job",
      "Parameters": {
        "params": {
          "id.$": "$.jobId",
          "data": {
            "customData": {
              "contactDate.$": "$.event.payload.scheduledAt",
              "bookedDate.$": "$.event.payload.scheduledAt",
              "attendanceDate.$": "$.event.payload.appointmentDate",
              "workflowPhase": "scheduled"
            }
          }
        }
      },
      "ResultPath": "$.jobUpdate",
      "Next": "CompleteCallToScheduleTask"
    },
    "CompleteCallToScheduleTask": {
      "Type": "Task",
      "Comment": "Close the Call to Schedule task with a link to the appointment.",
      "Resource": "tool.claims.update_task",
      "Parameters": {
        "params": {
          "id.$": "$.callToScheduleTask.id",
          "data": {
            "status": "Completed",
            "relatedAppointmentId.$": "$.event.payload.appointmentId"
          }
        }
      },
      "ResultPath": "$.taskCloseResult",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.taskCloseError",
          "Next": "CreateBookSiteTaskAndComplete"
        }
      ],
      "Next": "CreateBookSiteTaskAndComplete"
    },
    "CreateBookSiteTaskAndComplete": {
      "Type": "Pass",
      "Comment": "Skip book-site-attendance task creation since appointment already scheduled.",
      "Parameters": {
        "phase": "scheduled",
        "attendanceDate.$": "$.event.payload.appointmentDate"
      },
      "ResultPath": "$.scheduling",
      "Next": "CalculateSubmissionDueDate"
    },
    "OnCustomerContacted": {
      "Type": "Task",
      "Comment": "Customer contacted. Set Contact Date and calculate Attendance Due Date.",
      "Resource": "tool.claims.update_job",
      "Parameters": {
        "params": {
          "id.$": "$.jobId",
          "data": {
            "customData": {
              "contactDate.$": "$.event.payload.completedAt",
              "workflowPhase": "contacted"
            }
          }
        }
      },
      "ResultPath": "$.jobUpdate",
      "Next": "CalculateAttendanceDueDate"
    },
    "CalculateAttendanceDueDate": {
      "Type": "Task",
      "Comment": "Call calculate_dates to compute attendanceDueDate from contactDate.",
      "Resource": "tool.claims.calculate_dates",
      "Parameters": {
        "params": {
          "jobId.$": "$.jobId",
          "contactDate.$": "$.event.payload.completedAt"
        }
      },
      "ResultPath": "$.calculatedDates",
      "Next": "WriteAttendanceDueDate"
    },
    "WriteAttendanceDueDate": {
      "Type": "Task",
      "Comment": "Persist the computed attendanceDueDate to the job.",
      "Resource": "tool.claims.update_job",
      "Parameters": {
        "params": {
          "id.$": "$.jobId",
          "data": {
            "customData": {
              "attendanceDueDate.$": "$.calculatedDates.attendanceDueDate"
            }
          }
        }
      },
      "ResultPath": "$.dateUpdate",
      "Next": "CreateBookSiteAttendanceTask"
    },
    "CreateBookSiteAttendanceTask": {
      "Type": "Task",
      "Comment": "Create the 'Book Site Attendance' task.",
      "Resource": "tool.claims.create_task",
      "Parameters": {
        "params": {
          "data": {
            "name": "Book Site Attendance",
            "relatedEntityType": "Job",
            "relatedEntityId.$": "$.jobId",
            "jobId.$": "$.jobId",
            "priority": "High",
            "status": "Open",
            "originType": "automation",
            "action": {
              "actionKey": "create_appointment",
              "label": "Book site attendance",
              "context": {
                "entityType": "Appointment",
                "jobId.$": "$.jobId"
              }
            }
          }
        }
      },
      "ResultPath": "$.bookSiteTask",
      "Next": "WaitForAppointmentScheduled"
    },
    "WaitForAppointmentScheduled": {
      "Type": "Task",
      "Resource": "states.waitForTaskToken",
      "Parameters": {
        "eventPatterns": [
          {
            "eventType": "appointment.scheduled"
          }
        ]
      },
      "ResultPath": "$.event",
      "Next": "WaitForAppointmentScheduled__Route",
      "Comment": "Wait for the site attendance appointment to be scheduled."
    },
    "OnAppointmentScheduled": {
      "Type": "Task",
      "Comment": "Set Booked Date, Attendance Date; update status to Scheduled.",
      "Resource": "tool.claims.update_job",
      "Parameters": {
        "params": {
          "id.$": "$.jobId",
          "data": {
            "customData": {
              "bookedDate.$": "$.event.payload.scheduledAt",
              "attendanceDate.$": "$.event.payload.appointmentDate",
              "workflowPhase": "scheduled"
            }
          }
        }
      },
      "ResultPath": "$.jobUpdate",
      "Next": "CalculateSubmissionDueDate"
    },
    "CalculateSubmissionDueDate": {
      "Type": "Task",
      "Comment": "Call calculate_dates to compute submissionDueDate from attendanceDate.",
      "Resource": "tool.claims.calculate_dates",
      "Parameters": {
        "params": {
          "jobId.$": "$.jobId",
          "attendanceDate.$": "$.event.payload.appointmentDate"
        }
      },
      "ResultPath": "$.calculatedDates",
      "Next": "WriteSubmissionDueDate"
    },
    "WriteSubmissionDueDate": {
      "Type": "Task",
      "Comment": "Persist the computed submissionDueDate to the job.",
      "Resource": "tool.claims.update_job",
      "Parameters": {
        "params": {
          "id.$": "$.jobId",
          "data": {
            "customData": {
              "submissionDueDate.$": "$.calculatedDates.submissionDueDate"
            }
          }
        }
      },
      "ResultPath": "$.dateUpdate",
      "Next": "WaitForAttendanceDatePassed"
    },
    "WaitForAttendanceDatePassed": {
      "Type": "Task",
      "Resource": "states.waitForTaskToken",
      "Parameters": {
        "eventPatterns": [
          {
            "eventType": "attendance_date_passed"
          },
          {
            "eventType": "field.updated",
            "filter": {
              "field": "makeSafeRequired",
              "value": true
            }
          }
        ]
      },
      "ResultPath": "$.event",
      "Next": "WaitForAttendanceDatePassed__Route",
      "Comment": "Wait for the Attendance Date to pass (time-based trigger from scheduler) or a make-safe request."
    },
    "OnMakeSafeRequired": {
      "Type": "Task",
      "Comment": "Make Safe identified during inspection. Spawn a Builder Make Safe job.",
      "Resource": "tool.claims.create_job",
      "Parameters": {
        "params": {
          "data": {
            "claimId.$": "$.claimId",
            "jobTypeLookupId.$": "$.lookups.makeSafeJobType",
            "parentJobId.$": "$.jobId",
            "makeSafeRequired": true,
            "customData": {
              "workflowPhase": "allocated",
              "claimRecommendation": "Accept"
            }
          }
        }
      },
      "ResultPath": "$.makeSafeJob",
      "Next": "WaitForAttendanceDatePassed"
    },
    "OnAttendanceDatePassed": {
      "Type": "Task",
      "Comment": "Attendance Date has passed. Update status to Awaiting Submission, create Submission Required task.",
      "Resource": "tool.claims.update_job",
      "Parameters": {
        "params": {
          "id.$": "$.jobId",
          "data": {
            "customData": {
              "workflowPhase": "awaiting_submission"
            }
          }
        }
      },
      "ResultPath": "$.jobUpdate",
      "Next": "CreateSubmissionRequiredTask"
    },
    "CreateSubmissionRequiredTask": {
      "Type": "Task",
      "Comment": "Create the 'Submission Required' task.",
      "Resource": "tool.claims.create_task",
      "Parameters": {
        "params": {
          "data": {
            "name": "Submission Required",
            "relatedEntityType": "Job",
            "relatedEntityId.$": "$.jobId",
            "jobId.$": "$.jobId",
            "priority": "High",
            "status": "Open",
            "originType": "automation",
            "action": {
              "actionKey": "publish_quote",
              "label": "Submit estimate",
              "context": {
                "entityType": "Quote",
                "jobId.$": "$.jobId"
              }
            }
          }
        }
      },
      "ResultPath": "$.submissionTask",
      "Next": "WaitForQuotePublished"
    },
    "WaitForQuotePublished": {
      "Type": "Task",
      "Resource": "states.waitForTaskToken",
      "Parameters": {
        "eventPatterns": [
          {
            "eventType": "quote.published"
          }
        ]
      },
      "ResultPath": "$.event",
      "Next": "WaitForQuotePublished__Route",
      "Comment": "Wait for the assessment quote to be published."
    },
    "OnQuotePublished": {
      "Type": "Task",
      "Comment": "Quote published. Set First/Last Submission Date, status -> Awaiting Review.",
      "Resource": "tool.claims.update_job",
      "Parameters": {
        "params": {
          "id.$": "$.jobId",
          "data": {
            "customData": {
              "firstSubmissionDate.$": "$.event.payload.publishedAt",
              "lastSubmissionDate.$": "$.event.payload.publishedAt",
              "workflowPhase": "awaiting_review"
            }
          }
        }
      },
      "ResultPath": "$.jobUpdate",
      "Next": "EvaluateAutoApproval"
    },
    "EvaluateAutoApproval": {
      "Type": "Choice",
      "Comment": "Check if auto-approval criteria are met.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.event.payload.claimRecommendation",
              "StringEquals": "Accept"
            },
            {
              "Variable": "$.event.payload.autoApprovalApplies",
              "BooleanEquals": true
            },
            {
              "Variable": "$.event.payload.claimDecision",
              "StringEquals": "Accept"
            },
            {
              "Variable": "$.event.payload.withinDelegateAuthority",
              "BooleanEquals": true
            }
          ],
          "Next": "AutoApproveQuote"
        }
      ],
      "Default": "WaitForQuoteOutcome"
    },
    "AutoApproveQuote": {
      "Type": "Task",
      "Comment": "Auto-approve the quote.",
      "Resource": "tool.claims.approve_quote",
      "Parameters": {
        "params": {
          "id.$": "$.event.payload.quoteId"
        }
      },
      "ResultPath": "$.approveResult",
      "Next": "SpawnBuilderWorksJob"
    },
    "SpawnBuilderWorksJob": {
      "Type": "Task",
      "Comment": "Create a Builder Works job from the approved assessment quote.",
      "Resource": "tool.claims.create_job",
      "Parameters": {
        "params": {
          "data": {
            "claimId.$": "$.claimId",
            "jobTypeLookupId.$": "$.lookups.worksJobType",
            "parentJobId.$": "$.jobId",
            "collectExcess.$": "$.collectExcess",
            "excess.$": "$.excess",
            "customData": {
              "workflowPhase": "allocated",
              "claimRecommendation.$": "$.event.payload.claimRecommendation",
              "sourceAssessmentJobId.$": "$.jobId"
            }
          }
        }
      },
      "ResultPath": "$.worksJob",
      "Next": "WaitForInvoice"
    },
    "WaitForQuoteOutcome": {
      "Type": "Task",
      "Resource": "states.waitForTaskToken",
      "Parameters": {
        "eventPatterns": [
          {
            "eventType": "quote.status_changed",
            "filter": {
              "newStatus": "Approved"
            }
          },
          {
            "eventType": "quote.status_changed",
            "filter": {
              "newStatus": "Resubmission Required"
            }
          },
          {
            "eventType": "quote.status_changed",
            "filter": {
              "newStatus": "Cash Settled"
            }
          },
          {
            "eventType": "quote.status_changed",
            "filter": {
              "newStatus": "Declined"
            }
          },
          {
            "eventType": "quote.status_changed",
            "filter": {
              "newStatus": "Cancelled"
            }
          }
        ]
      },
      "ResultPath": "$.event",
      "Next": "WaitForQuoteOutcome__Route",
      "Comment": "Wait for insurer to review the quote."
    },
    "OnQuoteApproved": {
      "Type": "Task",
      "Comment": "Quote approved by insurer. Spawn Builder Works job.",
      "Resource": "tool.claims.create_job",
      "Parameters": {
        "params": {
          "data": {
            "claimId.$": "$.claimId",
            "jobTypeLookupId.$": "$.lookups.worksJobType",
            "parentJobId.$": "$.jobId",
            "collectExcess.$": "$.collectExcess",
            "excess.$": "$.excess",
            "customData": {
              "workflowPhase": "allocated",
              "claimRecommendation.$": "$.claimRecommendation",
              "sourceAssessmentJobId.$": "$.jobId"
            }
          }
        }
      },
      "ResultPath": "$.worksJob",
      "Next": "WaitForInvoice"
    },
    "OnResubmissionRequired": {
      "Type": "Task",
      "Comment": "Set status to Awaiting Resubmission and create new Submission Required task.",
      "Resource": "tool.claims.update_job",
      "Parameters": {
        "params": {
          "id.$": "$.jobId",
          "data": {
            "customData": {
              "workflowPhase": "awaiting_resubmission"
            }
          }
        }
      },
      "ResultPath": "$.jobUpdate",
      "Next": "CreateResubmissionTask"
    },
    "CreateResubmissionTask": {
      "Type": "Task",
      "Resource": "tool.claims.create_task",
      "Parameters": {
        "params": {
          "data": {
            "name": "Submission Required",
            "relatedEntityType": "Job",
            "relatedEntityId.$": "$.jobId",
            "jobId.$": "$.jobId",
            "priority": "High",
            "status": "Open",
            "originType": "automation",
            "description": "Resubmission required — revise and republish the assessment quote.",
            "action": {
              "actionKey": "publish_quote",
              "label": "Resubmit estimate",
              "context": {
                "entityType": "Quote",
                "jobId.$": "$.jobId"
              }
            }
          }
        }
      },
      "ResultPath": "$.resubmissionTask",
      "Next": "WaitForQuotePublished"
    },
    "OnQuoteFinalOutcome": {
      "Type": "Task",
      "Comment": "Quote reached a terminal status (Cash Settled / Declined / Cancelled).",
      "Resource": "tool.claims.update_job",
      "Parameters": {
        "params": {
          "id.$": "$.jobId",
          "data": {
            "customData": {
              "workflowPhase": "quote_finalized",
              "quoteOutcome.$": "$.event.payload.newStatus"
            }
          }
        }
      },
      "ResultPath": "$.jobUpdate",
      "Next": "WaitForInvoice"
    },
    "WaitForInvoice": {
      "Type": "Task",
      "Resource": "states.waitForTaskToken",
      "Parameters": {
        "eventPatterns": [
          {
            "eventType": "purchase_order.completed"
          },
          {
            "eventType": "invoice.approved"
          }
        ]
      },
      "ResultPath": "$.event",
      "Next": "WaitForInvoice__Route",
      "Comment": "Wait for invoice submission and PO completion."
    },
    "WaitForPOCompletion": {
      "Type": "Task",
      "Resource": "states.waitForTaskToken",
      "Parameters": {
        "eventPatterns": [
          {
            "eventType": "purchase_order.completed"
          }
        ]
      },
      "ResultPath": "$.event",
      "Next": "WaitForPOCompletion__Route",
      "Comment": "Invoice approved; wait for PO to reach completed status."
    },
    "CheckJobCompletion": {
      "Type": "Task",
      "Comment": "PO completed. Mark the job as Complete.",
      "Resource": "tool.claims.update_job",
      "Parameters": {
        "params": {
          "id.$": "$.jobId",
          "data": {
            "customData": {
              "workflowPhase": "complete"
            }
          }
        }
      },
      "ResultPath": "$.jobUpdate",
      "Next": "JobComplete"
    },
    "JobComplete": {
      "Type": "Succeed",
      "Comment": "Builder Assessment job workflow completed."
    },
    "WaitForInboundTaskOrCreate__Route": {
      "Type": "Choice",
      "Comment": "Route resume payload for WaitForInboundTaskOrCreate",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.event.eventType",
              "StringEquals": "task.created"
            },
            {
              "Variable": "$.event.payload.taskName",
              "StringEquals": "Call to Schedule"
            }
          ],
          "Next": "BindInboundCallToScheduleTaskFromEvent"
        }
      ],
      "Default": "WaitForInboundTaskOrCreate"
    },
    "WaitForContactOrSchedule__Route": {
      "Type": "Choice",
      "Comment": "Route resume payload for WaitForContactOrSchedule",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.event.eventType",
              "StringEquals": "task.completed"
            },
            {
              "Variable": "$.event.payload.taskName",
              "StringEquals": "Call to Schedule"
            }
          ],
          "Next": "OnCustomerContacted"
        },
        {
          "And": [
            {
              "Variable": "$.event.eventType",
              "StringEquals": "task.failed"
            },
            {
              "Variable": "$.event.payload.taskName",
              "StringEquals": "Call to Schedule"
            }
          ],
          "Next": "OnCallToScheduleFailed"
        },
        {
          "Variable": "$.event.eventType",
          "StringEquals": "appointment.scheduled",
          "Next": "OnAppointmentScheduledEarly"
        }
      ],
      "Default": "WaitForContactOrSchedule"
    },
    "WaitForContactOrScheduleRetry__Route": {
      "Type": "Choice",
      "Comment": "Route resume payload for WaitForContactOrScheduleRetry",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.event.eventType",
              "StringEquals": "task.completed"
            },
            {
              "Variable": "$.event.payload.taskName",
              "StringEquals": "Call to Schedule #2"
            }
          ],
          "Next": "OnCustomerContacted"
        },
        {
          "Variable": "$.event.eventType",
          "StringEquals": "appointment.scheduled",
          "Next": "OnAppointmentScheduledEarly"
        }
      ],
      "Default": "WaitForContactOrScheduleRetry"
    },
    "WaitForAppointmentScheduled__Route": {
      "Type": "Choice",
      "Comment": "Route resume payload for WaitForAppointmentScheduled",
      "Choices": [
        {
          "Variable": "$.event.eventType",
          "StringEquals": "appointment.scheduled",
          "Next": "OnAppointmentScheduled"
        }
      ],
      "Default": "WaitForAppointmentScheduled"
    },
    "WaitForAttendanceDatePassed__Route": {
      "Type": "Choice",
      "Comment": "Route resume payload for WaitForAttendanceDatePassed",
      "Choices": [
        {
          "Variable": "$.event.eventType",
          "StringEquals": "attendance_date_passed",
          "Next": "OnAttendanceDatePassed"
        },
